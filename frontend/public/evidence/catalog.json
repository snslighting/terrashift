ed without loop closure; this is not a calibrated velocity."]},{"id":"venezuela-2026","name":"Caracas coast","region":"Venezuela","bbox":[-67.3,10.02,-66.4,10.7],"change_types":["earthquake"],"primary_layer":"los","headline":"A magnitude 7.5 earthquake moved the Caracas coast \u2014 radar captured the 12 days around it.","summary":"On 24 June 2026 two large earthquakes (M7.2 and M7.5, 33 seconds apart) struck northern Venezuela. NISAR imaged the coast on 13 and 25 June, bracketing both.","status":"measured_provisional","event":{"events":[{"id":"us6000t7zp","magnitude":7.5,"place":"20 km W of Catia La Mar, Venezuela","time":"2026-06-24T22:05:04Z","longitude":-67.2205,"latitude":10.5955},{"id":"us6000t7zc","magnitude":7.2,"place":"20 km E of San Felipe, Venezuela","time":"2026-06-24T22:04:31Z","longitude":-68.5564,"latitude":10.3713}],"source":"https://earthquake.usgs.gov/earthquakes/eventpage/us6000t7zp"},"pairs":[{"id":"venezuela-2026-06-13","granule":"NISAR_L2_PR_GUNW_022_162_A_007_023_4000_SH_20260613T100656_20260613T100731_20260625T100655_20260625T100730_P05023_N_F_J_001","before":"2026-06-13","after":"2026-06-25","track":162,"frame":7,"orbit":"Ascending","product_version":"1.0.11","schema":"1.5.0","doi":"10.5067/NIL2GUNW-P1","processor_version":"0.25.16","correction_equation":"native_phase - ionosphere - wet - hydrostatic + solid_earth_tide","ionosphere_policy":"included_for_sensitivity_only","coherence_threshold":0.35,"accepted_pixels":187872,"coordinates":[[-67.30371174843937,10.706139943980395],[-66.71875855800403,10.706139943980395],[-66.71875855800403,10.016326212746591],[-67.30371174843937,10.016326212746591]],"grid":{"size":256,"bounds_mercator":[-7492214.9203335345,1120735.483656191,-7427098.229036371,1198798.6374027675]},"layers":{"disturbance":{"file":"grids/venezuela-2026-06-13-disturbance.bin","counts":"grids/venezuela-2026-06-13-disturbance.count.bin","count_type":"uint8","step":0.0001,"nodata":-32768,"unit":"","kind":"disturbance","native_statistic